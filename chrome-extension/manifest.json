{
  "manifest_version": 3,
  "name": "MCP Browser Control",
  "version": "0.1.0",
  "description": "Connects this browser profile to a local MCP browser control server.",
  "minimum_chrome_version": "116",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "MCP Browser Control",
    "default_popup": "src/popup.html"
  }
}
